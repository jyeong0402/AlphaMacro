# Never commit the real .env file or API keys.
DATABASE_URL=sqlite:///./alphamacro.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret

# Provider credentials
FRED_API_KEY=paste-your-fred-key-here
NEWS_API_KEY=paste-your-newsapi-key-here
SEC_USER_AGENT=AlphaMacro admin@example.com
NEWS_API_URL=https://newsapi.org/v2/everything

# Enable scheduled persistence
REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=24
REFRESH_LOOKBACK_DAYS=7
ALERT_CHECK_INTERVAL_SECONDS=60
REFRESH_TICKERS=SPY,NVDA
# Optional display-name:fred-series-id pairs
REFRESH_FRED_SERIES=DFF:DFF,DGS10:DGS10
